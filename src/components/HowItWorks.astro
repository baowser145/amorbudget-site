---
/*
 * Every figure below traces back to a claim the site already makes in
 * Features.astro — buckets, bank linking, the one number, manual logging.
 * Nothing here states a price or a setup time, because neither is settled
 * and a stat card is the worst place to guess.
 */
const steps = [
  {
    n: '01',
    title: 'Add your income and bills',
    body: 'Enter what you earn and when bills are due.',
  },
  {
    n: '02',
    title: 'Set what you want to save',
    body: 'Choose how much to put aside each month.',
  },
  {
    n: '03',
    title: 'Spend with confidence',
    body: "One number: what's safe to spend today.",
  },
];

const stats = [
  { figure: '1', label: 'Number to know', note: "What's safe to spend today", tone: 'olive' },
  { figure: '2', label: 'Buckets', note: 'Needs, and everything else', tone: 'blush' },
  { figure: '0', label: 'Bank logins', note: 'Nothing to connect', tone: 'gold' },
  { figure: 'Secs', label: 'To log a spend', note: 'Manual, on purpose', tone: 'cream' },
];
---

<section id="how" class="section band band-dark on-dark">
  <div class="container how-grid">
    <div class="how-copy" data-reveal>
      <p class="eyebrow-bare">How it works</p>
      <h2 class="h2">
        One number.<br />
        <em class="ital ital-olive">Zero stress.</em>
      </h2>
      <p class="lede">
        Amor Budget sets aside your bills and savings, then shows what&rsquo;s
        left to spend today.
      </p>

      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <div>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="stats" data-reveal>
      {
        stats.map((s, i) => (
          <li class={`stat stat-${s.tone}`} style={`transition-delay: ${i * 70}ms`}>
            <p class="stat-figure">{s.figure}</p>
            <p class="stat-label">{s.label}</p>
            <p class="stat-note">{s.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .how-copy .h2 {
    margin-bottom: var(--space-3);
  }

  .how-copy .lede {
    max-width: 44ch;
    margin-bottom: var(--space-4);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--ab-wants);
    background: rgba(233, 167, 155, 0.14);
  }

  .step-title {
    margin: 0 0 4px;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ab-accent-on);
  }

  .step-body {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--muted-on-ink);
  }

  /* ---------- stat cards ---------- */

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .stat {
    padding: clamp(20px, 2.6vw, 30px);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat-figure {
    margin: 0 0 10px;
    font-family: var(--ab-display);
    font-variation-settings: 'opsz' 144;
    font-weight: 700;
    font-size: clamp(2.1rem, 3.4vw, 2.9rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-olive .stat-figure {
    color: #a9c199;
  }

  .stat-blush .stat-figure {
    color: var(--ab-wants);
  }

  .stat-gold .stat-figure {
    color: var(--ab-gold);
  }

  .stat-cream .stat-figure {
    color: var(--ab-accent-on);
  }

  .stat-label {
    margin: 0 0 4px;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ab-accent-on);
  }

  .stat-note {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted-on-ink);
  }

  @media (max-width: 900px) {
    .how-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
