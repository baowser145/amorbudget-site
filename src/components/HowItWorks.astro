---
/*
 * Headline plus the three steps, full width. The stat-card grid that used to
 * fill the right column was deleted 2026-08-15 — after losing its captions in
 * the dedupe pass, every figure just restated a claim made elsewhere on the
 * page. Don't reintroduce numbers here that aren't settled facts (price,
 * setup time).
 */
const steps = [
  {
    n: '01',
    title: 'Add your income and bills',
    body: 'Enter what you earn and when bills are due.',
  },
  {
    n: '02',
    title: 'Set what you want to save',
    body: 'Choose how much to put aside each month.',
  },
  {
    n: '03',
    title: 'Spend with confidence',
    body: 'Check your number before you buy.',
  },
];
---

<section id="how" class="section band band-dark on-dark">
  <div class="container">
    <div class="how-head" data-reveal>
      <p class="eyebrow-bare">How it works</p>
      <h2 class="h2">
        One number. <em class="ital ital-olive">Zero stress.</em>
      </h2>
    </div>

    <ol class="steps" data-reveal>
      {
        steps.map((s, i) => (
          <li class="step" style={`transition-delay: ${i * 80}ms`}>
            <span class="step-n">{s.n}</span>
            <div>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-body">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how-head {
    margin-bottom: var(--space-5);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--ab-wants);
    background: rgba(233, 167, 155, 0.14);
  }

  .step-title {
    margin: 0 0 4px;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ab-accent-on);
  }

  .step-body {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--muted-on-ink);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
