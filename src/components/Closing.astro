---
import { site } from '../data/site';

/*
 * The Figma's closing "Download on the App Store" button, live at last —
 * this section shipped a "coming soon" status pill until the 2026-08
 * release. Merch stays as the secondary action so the storefront keeps a
 * below-the-fold entry point.
 */
---

<section class="section band band-dark on-dark closing">
  <div class="container closing-inner" data-reveal>
    <p class="eyebrow-bare">iOS app</p>
    <h2 class="h2">
      Start feeling better<br />
      <em class="ital ital-olive">about money.</em>
    </h2>
    <p class="status">
      <span class="status-dot" aria-hidden="true"></span>
      Available now on the App Store
    </p>

    <div class="closing-actions">
      <a class="btn btn-primary" href={site.appStore.url} target="_blank" rel="noopener noreferrer">
        {site.appStore.label}
        <span class="btn-icon" aria-hidden="true">↗</span>
      </a>
      <a class="btn btn-ghost" href={site.shop.url} target="_blank" rel="noopener noreferrer">
        Shop the merch
        <span class="btn-icon" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .closing-inner {
    max-width: 44rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing-inner .h2 {
    margin-bottom: var(--space-4);
  }

  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 16px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    padding: 10px 20px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ab-accent-on);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ab-gold);
    box-shadow: 0 0 0 4px rgba(217, 180, 74, 0.18);
  }
</style>
