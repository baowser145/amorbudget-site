---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
---

<header class="nav">
  <div class="container">
    <div class="nav-pill">
      <a href="#top" class="nav-brand">
        <Image src={appIcon} alt="" width={32} height={32} class="nav-icon" />
        <span>Amor Budget</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#screenshots">Screenshots</a>
        <a href="#merch">Merch</a>
        <a class="btn btn-primary" href="mailto:baohuylamvu@gmail.com?subject=Amor%20Budget%20launch">Get notified</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 16px 0;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    background: var(--ab-surface);
    border: 1.5px solid var(--ab-border);
    box-shadow: 0 12px 30px -14px rgba(0, 0, 0, 0.3);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 17px;
    color: var(--ab-ink);
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  .nav-icon {
    border-radius: 9px;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--ab-bg);
    border-radius: 999px;
    padding: 6px 6px 6px 18px;
  }

  .nav-links a:not(.btn) {
    position: relative;
    font-size: 14.5px;
    font-weight: 700;
    color: var(--muted-copy);
    text-decoration: none;
    padding: 8px 2px;
  }

  .nav-links a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 2px;
    border-radius: 999px;
    background: var(--ab-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-links a:not(.btn):hover {
    color: var(--ab-accent);
  }

  .nav-links a:not(.btn):hover::after {
    transform: scaleX(1);
  }

  .nav-links .btn {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .nav-links a:not(.btn) {
      display: none;
    }
    .nav-links {
      padding: 6px;
      background: none;
    }
    .nav-brand span {
      display: none;
    }
  }
</style>
