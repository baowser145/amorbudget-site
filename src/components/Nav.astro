---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { site, hasShopUrl } from '../data/site';

const shopLive = hasShopUrl();
const merchHref = shopLive ? site.shop.url.trim() : '#merch';
const merchExternal = shopLive;

const links = [
  { href: '#features', label: 'Features' },
  { href: '#screenshots', label: 'App' },
  { href: '#resources', label: 'Resources' },
  {
    href: merchHref,
    label: 'Merch',
    external: merchExternal,
  },
];
---

<header class="nav">
  <div class="container nav-wrap">
    <div class="nav-island">
      <a href="#top" class="nav-brand">
        <Image src={appIcon} alt="" width={34} height={34} class="nav-icon" />
        <span class="nav-brand-text">Amor Budget</span>
      </a>

      <nav class="nav-desktop" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {l.label}
              {l.external ? <span class="ext" aria-hidden="true">↗</span> : null}
            </a>
          ))
        }
      </nav>

      <a class="nav-cta btn btn-primary btn-plain" href="#screenshots">See the app</a>

      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-toggle
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav-panel" id="nav-panel" data-nav-panel hidden>
    <nav class="nav-panel-links" aria-label="Mobile">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            style={`--i: ${i}`}
            data-nav-close
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {l.label}
            {l.external ? <span class="ext" aria-hidden="true">↗</span> : null}
          </a>
        ))
      }
      <a class="btn btn-primary btn-plain nav-panel-cta" href="#screenshots" data-nav-close>
        See the app
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.querySelector('[data-nav-panel]');
  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      panel.hidden = !open;
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('[data-nav-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style is:global>
  body.nav-open {
    overflow: hidden;
  }
</style>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 18px 0 0;
  }

  .nav-wrap {
    position: relative;
    z-index: 2;
  }

  .nav-island {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px 10px 8px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ab-surface-raised) 78%, transparent);
    border: 1px solid var(--ab-border-strong);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ab-ink);
    font-weight: 900;
    font-size: 16px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    padding-right: 4px;
  }

  .nav-icon {
    border-radius: 10px;
    box-shadow: 0 2px 8px -2px rgba(43, 46, 35, 0.25);
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    margin-right: 4px;
  }

  .nav-desktop a {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted-copy);
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 999px;
    transition:
      color 220ms var(--ease-spring),
      background-color 220ms var(--ease-spring);
  }

  .nav-desktop a:hover {
    color: var(--ab-accent);
    background: var(--ab-accent-soft);
  }

  .ext {
    margin-left: 3px;
    font-size: 11px;
    opacity: 0.7;
  }

  .nav-cta {
    flex-shrink: 0;
    min-height: 44px;
    font-size: 14px;
    padding: 0 18px;
  }

  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 999px;
    background: var(--ab-bg-deep);
    cursor: pointer;
    flex-shrink: 0;
    margin-left: auto;
  }

  .nav-toggle-bar {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--ab-ink);
    transition:
      transform 320ms var(--ease-spring),
      top 320ms var(--ease-spring),
      opacity 200ms ease;
  }

  .nav-toggle-bar:first-child {
    top: 17px;
  }

  .nav-toggle-bar:last-child {
    top: 25px;
  }

  .nav-toggle.is-open .nav-toggle-bar:first-child {
    top: 21px;
    transform: rotate(45deg);
  }

  .nav-toggle.is-open .nav-toggle-bar:last-child {
    top: 21px;
    transform: rotate(-45deg);
  }

  .nav-panel {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding: 100px 20px 40px;
    background: color-mix(in srgb, var(--ab-bg) 88%, transparent);
    backdrop-filter: blur(24px) saturate(1.15);
    -webkit-backdrop-filter: blur(24px) saturate(1.15);
  }

  .nav-panel[hidden] {
    display: none;
  }

  .nav-panel-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 420px;
    margin: 0 auto;
  }

  .nav-panel-links a:not(.btn) {
    font-size: 1.65rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--ab-ink);
    text-decoration: none;
    padding: 14px 8px;
    border-bottom: 1px solid var(--ab-border);
    opacity: 0;
    transform: translateY(18px);
    animation: panel-in 500ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 60ms + 40ms);
  }

  .nav-panel-cta {
    margin-top: 20px;
    width: 100%;
    opacity: 0;
    animation: panel-in 500ms var(--ease-out) both;
    animation-delay: 280ms;
  }

  @keyframes panel-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .nav-cta {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .nav-brand-text {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .nav {
      padding-top: 12px;
    }

    .nav-island {
      min-height: 56px;
    }
  }
</style>
