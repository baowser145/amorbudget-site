---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { site } from '../data/site';

/*
 * Root-relative hashes, not bare ones: these anchors have to work from
 * /merch too, where a bare "#features" points at nothing. On the homepage
 * the browser still treats "/#features" as a same-document fragment, so
 * smooth scrolling is unaffected.
 *
 * "Merch" goes straight to the Shopify storefront (user request, 2026-08-15)
 * — not to /merch or the homepage section.
 */
const links = [
  { href: '/#features', label: 'Features' },
  { href: site.shop.url, label: 'Merch', external: true },
];
---

<header class="nav">
  <div class="container nav-wrap">
    <div class="nav-island">
      <a href="/" class="nav-brand">
        <Image src={appIcon} alt="" width={34} height={34} class="nav-icon" />
        <span class="nav-brand-text">Amor Budget</span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {l.label}
              {l.external ? <span class="ext" aria-hidden="true">↗</span> : null}
            </a>
          ))
        }
      </nav>

      <a
        class="nav-cta btn btn-primary btn-plain"
        href={site.appStore.url}
        target="_blank"
        rel="noopener noreferrer">Download</a
      >
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    padding: 18px 0 0;
  }

  .nav-wrap {
    position: relative;
    z-index: 2;
  }

  .nav-island {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 8px 10px 8px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ab-surface-raised) 78%, transparent);
    border: 1px solid var(--ab-border-strong);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ab-ink);
    font-weight: 900;
    font-size: 16px;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    padding-right: 4px;
  }

  .nav-icon {
    border-radius: 10px;
    box-shadow: 0 2px 8px -2px rgba(43, 46, 35, 0.25);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    margin-right: 4px;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted-copy);
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      color 220ms var(--ease-spring),
      background-color 220ms var(--ease-spring);
  }

  .nav-links a:hover {
    color: var(--ab-accent);
    background: var(--ab-accent-soft);
  }

  .ext {
    margin-left: 3px;
    font-size: 11px;
    opacity: 0.7;
  }

  .nav-cta {
    flex-shrink: 0;
    min-height: 44px;
    font-size: 14px;
    padding: 0 18px;
  }

  /*
   * Every link stays visible at every width — no hamburger. A phone user
   * reported not being able to find Merch when the links were hidden, so
   * narrow screens tighten spacing and drop the CTA instead — on a phone
   * the hero's App Store button is one scroll-stop below anyway.
   */
  @media (max-width: 860px) {
    .nav-cta {
      display: none;
    }

    .nav-brand-text {
      display: none;
    }

    .nav-links {
      margin-right: 0;
    }

    .nav-links a {
      font-size: 13px;
      padding: 10px 10px;
    }
  }

  @media (max-width: 560px) {
    .nav {
      padding-top: 12px;
    }

    .nav-island {
      min-height: 56px;
      gap: 6px;
      padding: 6px 8px 6px 10px;
    }

    .nav-links a {
      font-size: 12px;
      padding: 9px 7px;
    }
  }

  @media (max-width: 380px) {
    .nav-island {
      gap: 2px;
      padding: 6px 6px 6px 8px;
    }

    .nav-links a {
      font-size: 11px;
      padding: 9px 5px;
      letter-spacing: -0.01em;
    }
  }
</style>
