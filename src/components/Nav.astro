---
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
---

<header class="nav">
  <div class="container nav-row">
    <a href="#top" class="nav-brand">
      <Image src={appIcon} alt="" width={32} height={32} class="nav-icon" />
      <span>Amor Budget</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="#features">Features</a>
      <a href="#screenshots">Screenshots</a>
      <a href="#merch">Merch</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(250, 248, 241, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1.5px solid var(--ab-border);
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 17px;
    color: var(--ab-ink);
    text-decoration: none;
    letter-spacing: -0.3px;
  }

  .nav-icon {
    border-radius: 9px;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: var(--space-4);
  }

  .nav-links a {
    font-size: 15px;
    font-weight: 700;
    color: var(--ab-muted);
    text-decoration: none;
    padding: 10px 2px;
  }

  .nav-links a:hover {
    color: var(--ab-accent);
  }

  @media (max-width: 560px) {
    .nav-links {
      gap: var(--space-3);
    }
    .nav-brand span {
      display: none;
    }
  }
</style>
