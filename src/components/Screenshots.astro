---
import { Image } from 'astro:assets';
import homeShot from '../assets/screenshots/home.png';
---

<section id="screenshots" class="section screenshots-section">
  <div class="container screenshots-row">
    <div class="screenshots-media" data-reveal>
      <div class="phone-glow" aria-hidden="true"></div>
      <div class="phone-frame">
        <Image
          src={homeShot}
          alt="Amor Budget's Home tab showing today's Needs and Wants budget, upcoming bills, and recent spending"
          widths={[320, 480, 640]}
          sizes="(max-width: 720px) 240px, 320px"
          loading="lazy"
          class="phone-screen"
        />
      </div>
    </div>
    <div class="screenshots-copy" data-reveal style="transition-delay: 120ms">
      <h2 class="h2">Home shows everything you need in one glance.</h2>
      <p class="lede">
        Today's budget, bills due this week, and your last few purchases,
        all on one screen. No digging through menus to find out where you
        stand.
      </p>
    </div>
  </div>
</section>

<style>
  .screenshots-section {
    background: var(--ab-ink);
    color: var(--ab-accent-on);
  }

  .screenshots-row {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
    gap: var(--space-6);
  }

  .screenshots-copy {
    padding-top: var(--space-5);
  }

  .screenshots-copy .h2 {
    color: var(--ab-accent-on);
    margin-bottom: var(--space-2);
  }

  .screenshots-copy .lede {
    color: var(--muted-on-ink);
    max-width: 44ch;
  }

  .screenshots-media {
    position: relative;
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }

  .phone-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 380px;
    height: 380px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, var(--ab-accent) 0%, rgba(95, 122, 82, 0) 70%);
    opacity: 0.35;
    z-index: 0;
  }

  .phone-frame {
    position: relative;
    z-index: 1;
    width: 280px;
    border-radius: 36px;
    background: var(--ab-ink);
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 60px -16px rgba(0, 0, 0, 0.55);
    transform: rotate(-2deg);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .screenshots-media:hover .phone-frame {
    transform: rotate(0deg) translateY(-6px);
  }

  .phone-screen {
    width: 100%;
    height: auto;
    border-radius: 27px;
  }

  @media (max-width: 860px) {
    .screenshots-row {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .screenshots-copy .lede {
      margin-left: auto;
      margin-right: auto;
    }
    .phone-frame {
      width: 230px;
      transform: rotate(-1deg);
    }
  }
</style>
