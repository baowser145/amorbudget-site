---
import { Image } from 'astro:assets';
import homeShot from '../assets/screenshots/home.png';

/*
 * Each point spotlights a region of home.png. The rect is a percentage of the
 * screenshot box, measured off the 1206x2622 source — re-measure these if the
 * screenshot is ever recaptured.
 */
const points = [
  {
    id: 'needs',
    label: 'Needs vs Wants',
    body: 'Both buckets for today, at a glance.',
    rect: { left: 5.7, top: 15.0, width: 88.7, height: 16.9 },
  },
  {
    id: 'bills',
    label: 'Bills ahead',
    body: 'Due dates before they hit your balance.',
    rect: { left: 6.0, top: 34.3, width: 88.0, height: 20.7 },
  },
  {
    id: 'log',
    label: 'Manual & private',
    body: 'Log spending in seconds. No bank login.',
    rect: { left: 6.0, top: 65.5, width: 88.6, height: 24.5 },
  },
];
---

<section id="screenshots" class="section screenshots">
  <div class="container screenshots-grid">
    <div class="screenshots-media" data-reveal>
      <div class="media-glow" aria-hidden="true"></div>
      <div class="phone-shell">
        <div class="phone-frame">
          <div class="phone-screen-wrap">
            <Image
              src={homeShot}
              alt="Amor Budget Home tab with today's Needs and Wants, upcoming bills, and recent spending"
              widths={[320, 480, 640]}
              sizes="(max-width: 768px) 230px, 300px"
              loading="lazy"
              class="phone-screen"
            />
            <div class="spots" aria-hidden="true">
              {
                points.map((p, i) => (
                  <span
                    class="spot"
                    data-spot={p.id}
                    style={`left:${p.rect.left}%;top:${p.rect.top}%;width:${p.rect.width}%;height:${p.rect.height}%`}
                  >
                    <span class="spot-num">{String(i + 1).padStart(2, '0')}</span>
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="screenshots-copy" data-reveal style="transition-delay: 100ms">
      <p class="eyebrow">The app</p>
      <h2 class="h2">Everything on one screen.</h2>
      <ul class="points">
        {
          points.map((p, i) => (
            <li>
              <button type="button" class="point" data-spot={p.id}>
                <span class="point-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="point-text">
                  <span class="point-label">{p.label}</span>
                  <span class="point-body">{p.body}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="points-hint">Hover or tap a point to find it on the screen.</p>
    </div>
  </div>
</section>

<style>
  .screenshots {
    position: relative;
    background: var(--ink-deep);
    color: var(--ab-accent-on);
    overflow: clip;
  }

  .screenshots::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 15% 50%, rgba(95, 122, 82, 0.22), transparent 60%),
      radial-gradient(ellipse 40% 40% at 90% 20%, rgba(233, 167, 155, 0.1), transparent 55%);
    pointer-events: none;
  }

  .screenshots-grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .screenshots-media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .media-glow {
    position: absolute;
    width: 360px;
    height: 360px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(95, 122, 82, 0.4), transparent 70%);
    pointer-events: none;
  }

  .phone-shell {
    position: relative;
    z-index: 1;
    padding: 10px;
    border-radius: 44px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
    transform: rotate(-2.5deg);
    transition: transform 600ms var(--ease-spring);
  }

  .screenshots-media:hover .phone-shell {
    transform: rotate(0deg) translateY(-8px);
  }

  .phone-frame {
    width: min(280px, 68vw);
    border-radius: 36px;
    background: #12140f;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Clips the spotlight's oversized box-shadow to the screen itself. */
  .phone-screen-wrap {
    position: relative;
    border-radius: 27px;
    overflow: hidden;
    line-height: 0;
  }

  .phone-screen {
    width: 100%;
    height: auto;
  }

  .spots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /*
   * Narrow screens get the static version: every region ringed and numbered
   * to match the list. The spotlight needs the phone and the list on screen
   * together, which only holds once the layout goes two-column.
   */
  .spot {
    position: absolute;
    border-radius: 10px;
    border: 2px solid rgba(217, 180, 74, 0.85);
    transition:
      opacity 320ms var(--ease-out),
      transform 320ms var(--ease-spring);
  }

  .spot-num {
    position: absolute;
    top: -9px;
    left: -9px;
    min-width: 20px;
    padding: 2px 5px;
    border-radius: 999px;
    background: var(--ab-gold, #d9b44a);
    color: #2b2e23;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }

  .screenshots-copy .eyebrow {
    color: #c5d6b8;
    background: rgba(95, 122, 82, 0.22);
    border-color: rgba(197, 214, 184, 0.15);
    margin-bottom: var(--space-2);
  }

  .screenshots-copy .h2 {
    color: var(--ab-accent-on);
    margin-bottom: var(--space-4);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .point {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 14px;
    padding: 16px 18px;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      background-color 260ms var(--ease-out),
      border-color 260ms var(--ease-out),
      transform 260ms var(--ease-spring);
  }

  .point:focus-visible {
    outline: 2px solid var(--ab-gold, #d9b44a);
    outline-offset: 3px;
  }

  .point-num {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.7;
    color: var(--ab-gold, #d9b44a);
    transition: color 260ms var(--ease-out);
  }

  .point-text {
    display: grid;
    gap: 4px;
  }

  .point-label {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ab-accent-on);
    letter-spacing: -0.01em;
  }

  .point-body {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted-on-ink);
    line-height: 1.45;
  }

  .points-hint {
    display: none;
    margin: var(--space-3) 0 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted-on-ink);
    opacity: 0.75;
  }

  /*
   * Two-column layout only: the phone and the list sit side by side, so
   * lighting one region at a time actually reads. Hover and focus both drive
   * it, which means a tap works like a mouse — no JavaScript involved. With
   * nothing engaged the first point stays lit, so it looks deliberate on load.
   */
  @media (min-width: 901px) {
    .points-hint {
      display: block;
    }

    .spot-num {
      display: none;
    }

    .spot {
      opacity: 0;
      transform: scale(1.04);
      border-color: var(--ab-gold, #d9b44a);
      box-shadow: 0 0 0 9999px rgba(10, 12, 8, 0.72);
    }

    .screenshots-grid:has(.point[data-spot='needs']:hover) .spot[data-spot='needs'],
    .screenshots-grid:has(.point[data-spot='needs']:focus) .spot[data-spot='needs'],
    .screenshots-grid:has(.point[data-spot='bills']:hover) .spot[data-spot='bills'],
    .screenshots-grid:has(.point[data-spot='bills']:focus) .spot[data-spot='bills'],
    .screenshots-grid:has(.point[data-spot='log']:hover) .spot[data-spot='log'],
    .screenshots-grid:has(.point[data-spot='log']:focus) .spot[data-spot='log'],
    .screenshots-grid:not(:has(.point:hover)):not(:has(.point:focus))
      .spot[data-spot='needs'] {
      opacity: 1;
      transform: scale(1);
    }

    .screenshots-grid:has(.point:hover) .phone-shell,
    .screenshots-grid:has(.point:focus) .phone-shell {
      transform: rotate(0deg) translateY(-8px);
    }

    .point:hover,
    .point:focus,
    .screenshots-grid:not(:has(.point:hover)):not(:has(.point:focus))
      .point[data-spot='needs'] {
      background: rgba(217, 180, 74, 0.1);
      border-color: rgba(217, 180, 74, 0.42);
      transform: translateX(4px);
      outline: none;
    }

    .point:hover .point-num,
    .point:focus .point-num,
    .screenshots-grid:not(:has(.point:hover)):not(:has(.point:focus))
      .point[data-spot='needs']
      .point-num {
      color: var(--ab-gold, #d9b44a);
    }

    .point:not(:hover):not(:focus) .point-num {
      color: var(--muted-on-ink);
    }
  }

  @media (max-width: 900px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .screenshots-copy .lede,
    .screenshots-copy .eyebrow {
      margin-inline: auto;
    }

    .points {
      text-align: left;
      max-width: 28rem;
      margin-inline: auto;
    }

    .phone-shell {
      transform: rotate(-1deg);
    }
  }
</style>
