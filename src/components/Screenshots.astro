---
import { Image } from 'astro:assets';
import homeShot from '../assets/screenshots/home.png';
---

<section id="screenshots" class="section screenshots">
  <div class="container screenshots-grid">
    <div class="screenshots-media" data-reveal>
      <div class="media-glow" aria-hidden="true"></div>
      <div class="phone-shell">
        <div class="phone-frame">
          <Image
            src={homeShot}
            alt="Amor Budget Home tab with today's Needs and Wants, upcoming bills, and recent spending"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 230px, 300px"
            loading="lazy"
            class="phone-screen"
          />
        </div>
      </div>
    </div>

    <div class="screenshots-copy" data-reveal style="transition-delay: 100ms">
      <p class="eyebrow">The app</p>
      <h2 class="h2">Home shows everything you need in one glance.</h2>
      <p class="lede">
        Today&rsquo;s budget, bills due this week, and your last few purchases —
        all on one screen. No digging through menus to find out where you stand.
      </p>
      <ul class="points">
        <li>
          <span class="point-label">Needs vs Wants</span>
          <span class="point-body">See both buckets for today, not a single confusing number.</span>
        </li>
        <li>
          <span class="point-label">Bills ahead</span>
          <span class="point-body">Due dates show up early so payday math stays honest.</span>
        </li>
        <li>
          <span class="point-label">Manual & private</span>
          <span class="point-body">Log spending in seconds without connecting a bank.</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .screenshots {
    position: relative;
    background: var(--ink-deep);
    color: var(--ab-accent-on);
    overflow: clip;
  }

  .screenshots::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 15% 50%, rgba(95, 122, 82, 0.22), transparent 60%),
      radial-gradient(ellipse 40% 40% at 90% 20%, rgba(233, 167, 155, 0.1), transparent 55%);
    pointer-events: none;
  }

  .screenshots-grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .screenshots-media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .media-glow {
    position: absolute;
    width: 360px;
    height: 360px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(95, 122, 82, 0.4), transparent 70%);
    pointer-events: none;
  }

  .phone-shell {
    position: relative;
    z-index: 1;
    padding: 10px;
    border-radius: 44px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
    transform: rotate(-2.5deg);
    transition: transform 600ms var(--ease-spring);
  }

  .screenshots-media:hover .phone-shell {
    transform: rotate(0deg) translateY(-8px);
  }

  .phone-frame {
    width: min(280px, 68vw);
    border-radius: 36px;
    background: #12140f;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .phone-screen {
    width: 100%;
    height: auto;
    border-radius: 27px;
  }

  .screenshots-copy .eyebrow {
    color: #c5d6b8;
    background: rgba(95, 122, 82, 0.22);
    border-color: rgba(197, 214, 184, 0.15);
    margin-bottom: var(--space-2);
  }

  .screenshots-copy .h2 {
    color: var(--ab-accent-on);
    margin-bottom: var(--space-2);
  }

  .screenshots-copy .lede {
    color: var(--muted-on-ink);
    max-width: 40ch;
    margin-bottom: var(--space-4);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .points li {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .point-label {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ab-accent-on);
    letter-spacing: -0.01em;
  }

  .point-body {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted-on-ink);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .screenshots-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .screenshots-copy .lede {
      margin-inline: auto;
    }

    .screenshots-copy .eyebrow {
      margin-inline: auto;
    }

    .points {
      text-align: left;
      max-width: 28rem;
      margin-inline: auto;
    }

    .phone-shell {
      transform: rotate(-1deg);
    }
  }
</style>
