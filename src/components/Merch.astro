---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { products, isLive } from '../data/products';

/*
 * This is a teaser, not a storefront. It shows the flagship product and
 * links to its /merch page, which owns the "buy now" vs "not open yet"
 * split — one place to be right instead of two places to drift apart.
 */
const tee = products[0];
const live = tee ? isLive(tee) : false;
const href = tee ? `/merch/${tee.slug}` : '/merch';
---

<section id="merch" class="section merch">
  <div class="container" data-reveal>
    <div class="merch-shell">
      <div class="merch-card">
        {
          tee && (
            <a class="merch-photo" href={href} aria-label={tee.name}>
              <Image
                src={tee.images[0].src}
                alt={tee.images[0].alt}
                widths={[360, 540, 720]}
                sizes="(max-width: 700px) 78vw, 340px"
                loading="lazy"
              />
            </a>
          )
        }
        <div class="merch-copy">
          <p class="merch-eyebrow">{site.shop.brand} merch</p>
          <h2 class="h2">Wear the budget.</h2>
          {
            tee && (
              <p class="merch-product">
                {tee.name} · from {tee.priceFrom}
              </p>
            )
          }
          <a class="btn btn-primary" href={href}>
            {live ? 'Buy now' : 'See the shirt'}
            <span class="btn-icon" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .merch {
    padding-top: var(--space-6);
  }

  .merch-shell {
    padding: 6px;
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--ab-accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--ab-accent) 24%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .merch-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 56px);
    padding: clamp(32px, 5vw, 56px) clamp(24px, 5vw, 64px);
    border-radius: calc(var(--radius-2xl) - 4px);
    background:
      radial-gradient(ellipse 80% 70% at 20% 0%, rgba(255, 255, 255, 0.14), transparent 50%),
      linear-gradient(160deg, #6f8b61 0%, var(--ab-accent) 45%, #4a633f 100%);
    box-shadow: var(--shadow-inset);
  }

  .merch-photo {
    display: block;
    justify-self: center;
    max-width: 340px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.45);
    transform: rotate(-2deg);
    transition: transform 500ms var(--ease-spring);
  }

  .merch-photo:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .merch-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .merch-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .merch-eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 233, 0.92);
  }

  .merch-card .h2 {
    color: var(--ab-accent-on);
    max-width: 12ch;
  }

  .merch-product {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }

  .merch-card .btn-primary {
    background: var(--ab-accent-on);
    color: var(--ab-accent-hover);
    box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.35);
  }

  .merch-card .btn-primary .btn-icon {
    background: color-mix(in srgb, var(--ab-accent) 14%, white);
    color: var(--ab-accent-hover);
  }

  .merch-card .btn-primary:hover {
    background: #ffffff;
    box-shadow: 0 16px 32px -12px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 700px) {
    .merch-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .merch-copy {
      align-items: center;
    }

    .merch-photo {
      max-width: min(320px, 78vw);
    }
  }
</style>
