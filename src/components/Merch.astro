---
import { site, hasProductUrl } from '../data/site';

/*
 * This is a teaser, not a storefront. It always links to /merch and lets
 * that page own the "buy now" vs "not open yet" split — one place to be
 * right instead of two places to drift apart.
 */
const live = hasProductUrl();
const product = site.product;
---

<section id="merch" class="section merch">
  <div class="container" data-reveal>
    <div class="merch-shell">
      <div class="merch-card">
        <p class="merch-eyebrow">{product.eyebrow}</p>
        <h2 class="h2">{live ? 'Merch is live.' : 'Merch is on its way.'}</h2>
        <p class="lede">{site.shop.blurb}</p>
        <a class="btn btn-primary" href="/merch">
          {live ? product.name : 'See the first shirt'}
          <span class="btn-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .merch {
    padding-top: var(--space-6);
  }

  .merch-shell {
    padding: 6px;
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--ab-accent) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--ab-accent) 24%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .merch-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: clamp(40px, 7vw, 72px) clamp(24px, 5vw, 48px);
    border-radius: calc(var(--radius-2xl) - 4px);
    background:
      radial-gradient(ellipse 80% 70% at 20% 0%, rgba(255, 255, 255, 0.14), transparent 50%),
      linear-gradient(160deg, #6f8b61 0%, var(--ab-accent) 45%, #4a633f 100%);
    box-shadow: var(--shadow-inset);
  }

  .merch-eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 244, 233, 0.92);
  }

  .merch-card .h2 {
    color: var(--ab-accent-on);
    max-width: 16ch;
  }

  .merch-card .lede {
    color: rgba(255, 255, 255, 0.9);
    max-width: 40ch;
    margin-bottom: var(--space-2);
  }

  .merch-card .btn-primary {
    background: var(--ab-accent-on);
    color: var(--ab-accent-hover);
    box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.35);
  }

  .merch-card .btn-primary .btn-icon {
    background: color-mix(in srgb, var(--ab-accent) 14%, white);
    color: var(--ab-accent-hover);
  }

  .merch-card .btn-primary:hover {
    background: #ffffff;
    box-shadow: 0 16px 32px -12px rgba(0, 0, 0, 0.35);
  }
</style>
