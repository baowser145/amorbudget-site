<section id="merch" class="section merch">
  <div class="container merch-card">
    <p class="eyebrow">Merch</p>
    <h2 class="h2">Amor Budget gear is on its way.</h2>
    <p class="lede">
      Shirts, stickers, and a few surprises for people who've paid off a
      credit card and want to talk about it. Not open yet.
    </p>
    <a class="btn btn-primary" href="mailto:baohuylamvu@gmail.com?subject=Amor%20Budget%20merch">
      Tell me when it's live
    </a>
  </div>
</section>

<style>
  .merch-card {
    background: var(--ab-accent);
    border-radius: 28px;
    padding: var(--space-6) var(--space-4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .merch-card .eyebrow {
    color: var(--ab-accent-on);
    opacity: 0.75;
  }

  .merch-card .h2 {
    color: var(--ab-accent-on);
    max-width: 26ch;
  }

  .merch-card .lede {
    color: var(--ab-accent-on);
    opacity: 0.85;
    max-width: 46ch;
    margin-bottom: var(--space-1);
  }

  .merch-card .btn-primary {
    background: var(--ab-accent-on);
    color: var(--ab-accent-hover);
  }

  .merch-card .btn-primary:hover {
    background: #ffffff;
  }
</style>
