---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-row">
    <p class="footer-brand">Amor Budget</p>
    <p class="footer-copy">&copy; {year} Amor Budget. Budgeting you'll actually love.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1.5px solid var(--ab-border);
    padding: var(--space-4) 0;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .footer-brand {
    font-weight: 900;
    font-size: 15px;
    color: var(--ab-ink);
    margin: 0;
  }

  .footer-copy {
    font-size: 13px;
    font-weight: 700;
    color: var(--ab-faint);
    margin: 0;
  }
</style>
