---
import { Image } from 'astro:assets';
import loginShot from '../assets/screenshots/login.png';
---

<section id="top" class="hero">
  <svg class="hero-watermark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 21s-7.5-4.6-10-9.5C.5 7.5 3 3 7 3c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6.5 4.5 5 8.5-2.5 4.9-10 9.5-10 9.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="0.6"
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  </svg>
  <div class="container hero-row">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-in style="--hero-in-order: 0">Coming soon to iOS</p>
      <h1 class="h1" data-hero-in style="--hero-in-order: 1">
        Know exactly what's safe to spend, <span class="accent-word">today</span>.
      </h1>
      <p class="lede" data-hero-in style="--hero-in-order: 2">
        Amor Budget splits every dollar into Needs and Wants, tracks bills
        before they're due, and shows your real number for today. No bank
        linking, no spreadsheets.
      </p>
      <div class="hero-actions" data-hero-in style="--hero-in-order: 3">
        <a class="btn btn-primary" href="mailto:baohuylamvu@gmail.com?subject=Amor%20Budget%20launch">
          Get notified at launch
        </a>
        <a class="btn btn-ghost" href="#features">See how it works</a>
      </div>
    </div>
    <div class="hero-media" aria-hidden="true" data-hero-in style="--hero-in-order: 2">
      <div class="phone-frame">
        <Image
          src={loginShot}
          alt=""
          widths={[320, 480, 640]}
          sizes="(max-width: 720px) 240px, 320px"
          loading="eager"
          class="phone-screen"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-7) 0 var(--space-6);
    overflow: clip;
  }

  .hero-watermark {
    position: absolute;
    top: -60px;
    right: -160px;
    width: 620px;
    height: 620px;
    color: var(--ab-accent);
    opacity: 0.07;
    z-index: -1;
  }

  @media (max-width: 860px) {
    .hero-watermark {
      width: 420px;
      height: 420px;
      top: -40px;
      right: -180px;
    }
  }

  .hero-row {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-copy .eyebrow {
    color: var(--ab-accent);
    margin-bottom: var(--space-2);
  }

  .hero-copy .h1 {
    margin-bottom: var(--space-3);
    max-width: 15ch;
  }

  .accent-word {
    color: var(--ab-accent);
  }

  .hero-copy .lede {
    max-width: 46ch;
    margin-bottom: var(--space-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-media {
    display: flex;
    justify-content: center;
    perspective: 1400px;
  }

  .phone-frame {
    width: 280px;
    border-radius: 36px;
    background: var(--ab-ink);
    padding: 10px;
    box-shadow: 0 30px 60px -20px rgba(43, 46, 35, 0.35);
    transform: rotate(2deg);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-media:hover .phone-frame {
    transform: rotate(0deg) translateY(-6px);
  }

  .phone-screen {
    width: 100%;
    height: auto;
    border-radius: 27px;
  }

  @media (max-width: 860px) {
    .hero-row {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-copy .h1 {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-copy .lede {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-media {
      order: -1;
    }
    .phone-frame {
      width: 230px;
      transform: rotate(1deg);
    }
  }
</style>
