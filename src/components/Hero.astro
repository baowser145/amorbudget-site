---
import { Image } from 'astro:assets';
import homeShot from '../assets/screenshots/home.png';
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-in style="--hero-in-order: 0">Coming soon to iOS</p>
      {/* The {' '} is load-bearing: compressHTML strips a bare newline here,
          which fuses "spend" and "today" when the span renders inline. */}
      <h1 class="h1" data-hero-in style="--hero-in-order: 1">
        Know what&rsquo;s safe to spend{' '}
        <span class="accent-line">today</span>
      </h1>
      <p class="lede" data-hero-in style="--hero-in-order: 2">
        A budgeting app with one job: one number that says what you can
        spend right now, after bills and savings.
      </p>
      <div class="hero-actions" data-hero-in style="--hero-in-order: 3">
        <a class="btn btn-primary" href="#features">
          See how it works
          <span class="btn-icon" aria-hidden="true">↓</span>
        </a>
      </div>
      <ul class="hero-meta" data-hero-in style="--hero-in-order: 4">
        <li>No bank linking</li>
        <li>Private by design</li>
      </ul>
    </div>

    <div class="hero-stage" data-hero-in style="--hero-in-order: 2">
      <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-b" aria-hidden="true"></div>
      <div class="phone-shell">
        <div class="phone-frame">
          <Image
            src={homeShot}
            alt="Amor Budget Home tab showing today's Needs and Wants budget"
            widths={[320, 480, 640]}
            sizes="(max-width: 768px) 220px, 300px"
            loading="eager"
            class="phone-screen"
          />
        </div>
      </div>
      <div class="float-chip float-chip-1" data-hero-in style="--hero-in-order: 4">
        <span class="chip-dot chip-dot-needs"></span>
        Needs covered
      </div>
      <div class="float-chip float-chip-2" data-hero-in style="--hero-in-order: 5">
        <span class="chip-dot chip-dot-wants"></span>
        Wants left today
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(24px, 6vw, 88px) 0 clamp(40px, 9vw, 120px);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(40px, 6vw, 72px);
  }

  .hero-copy .eyebrow {
    margin-bottom: var(--space-3);
  }

  .hero-copy .h1 {
    max-width: 11ch;
    margin-bottom: var(--space-3);
  }

  .accent-line {
    display: block;
    color: var(--ab-accent);
  }

  .hero-copy .lede {
    max-width: 38ch;
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: var(--space-4);
  }

  .hero-meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  .hero-meta li {
    position: relative;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted-copy);
    padding-left: 14px;
  }

  .hero-meta li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ab-accent);
    transform: translateY(-50%);
    opacity: 0.7;
  }

  .hero-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 480px;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .hero-orb-a {
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, var(--ab-accent-glow), transparent 68%);
    top: 8%;
    right: 8%;
  }

  .hero-orb-b {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(233, 167, 155, 0.28), transparent 70%);
    bottom: 12%;
    left: 6%;
  }

  .phone-shell {
    position: relative;
    z-index: 2;
    padding: 10px;
    border-radius: 44px;
    background: color-mix(in srgb, var(--ab-ink) 6%, transparent);
    border: 1px solid var(--ab-border-strong);
    box-shadow: var(--shadow-float);
    transform: rotate(2.5deg);
    transition: transform 600ms var(--ease-spring);
  }

  .hero-stage:hover .phone-shell {
    transform: rotate(0deg) translateY(-8px);
  }

  .phone-frame {
    width: min(280px, 68vw);
    border-radius: 36px;
    background: var(--ink-deep);
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-inset);
  }

  .phone-screen {
    width: 100%;
    height: auto;
    border-radius: 27px;
  }

  .float-chip {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ab-surface-raised) 90%, transparent);
    border: 1px solid var(--ab-border-strong);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 800;
    color: var(--ab-ink);
    letter-spacing: -0.01em;
  }

  .float-chip-1 {
    top: 18%;
    left: 0;
  }

  .float-chip-2 {
    bottom: 20%;
    right: 0;
  }

  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .chip-dot-needs {
    background: var(--ab-accent);
  }

  .chip-dot-wants {
    background: var(--ab-wants);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-copy .h1 {
      max-width: none;
      margin-inline: auto;
    }

    .accent-line {
      display: inline;
    }

    .hero-copy .lede {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-meta {
      justify-content: center;
    }

    .hero-stage {
      order: -1;
      min-height: 420px;
    }

    .float-chip-1 {
      left: 4%;
      top: 10%;
    }

    .float-chip-2 {
      right: 4%;
      bottom: 12%;
    }

    .phone-shell {
      transform: rotate(1deg);
    }
  }

  @media (max-width: 480px) {
    .float-chip {
      font-size: 12px;
      padding: 10px 12px;
    }

    .hero-stage {
      min-height: 380px;
    }
  }
</style>
