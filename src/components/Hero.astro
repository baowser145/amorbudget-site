---
import { Image } from 'astro:assets';
import homeShot from '../assets/screenshots/home.png';

/*
 * The headline is the site tagline set as display type, with two phrases
 * pulled into tinted italic. Splitting it across explicit lines is
 * deliberate: `text-wrap: balance` would re-break "you'll" and "love." onto
 * arbitrary lines and the colour would land in the wrong place.
 *
 * No trust pills here on purpose — the no-bank and manual-logging claims
 * live once each, in Features and Privacy (2026-08 dedupe pass).
 */
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-hero-in style="--hero-in-order: 0">Coming soon to iOS</p>

      <h1 class="h1 hero-title" data-hero-in style="--hero-in-order: 1">
        <span class="line">Budgeting</span>
        <span class="line"><em class="ital ital-blush">you&rsquo;ll</em></span>
        <span class="line">actually <em class="ital ital-olive">love.</em></span>
      </h1>

      <p class="lede" data-hero-in style="--hero-in-order: 2">
        See what&rsquo;s safe to spend today, after bills and savings.
      </p>

      <div class="hero-actions" data-hero-in style="--hero-in-order: 3">
        <a class="btn btn-primary" href="#how">
          See how it works
          <span class="btn-icon" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="hero-stage" data-hero-in style="--hero-in-order: 2">
      <div class="device">
        <Image
          src={homeShot}
          alt="Amor Budget Home screen showing the amount that's safe to spend today, with Needs, Wants and Savings progress bars and recent transactions"
          widths={[380, 560, 760]}
          sizes="(max-width: 900px) 74vw, 360px"
          loading="eager"
          class="device-screen"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(32px, 6vw, 72px) 0 clamp(64px, 10vw, 120px);
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(40px, 6vw, 72px);
  }

  .hero-copy .eyebrow {
    margin-bottom: var(--space-3);
  }

  /*
   * Each line is its own block so the tinted italics stay on the lines they
   * were composed for. Negative word-spacing on the last line pulls
   * "actually love." tighter than Fraunces sets it by default.
   */
  .hero-title {
    margin-bottom: var(--space-3);
  }

  .hero-title .line {
    display: block;
  }

  .hero-title em {
    font-style: italic;
  }

  .hero-copy .lede {
    max-width: 42ch;
    margin-bottom: var(--space-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
  }

  .hero-stage {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /*
   * One device, one shadow, no tilt — see the 2026-08 hero pass. The frame is
   * the only dark object above the fold, which is what makes the screenshot
   * read as the subject rather than as page furniture.
   */
  .device {
    width: min(360px, 74vw);
    padding: 9px;
    border-radius: 46px;
    background: var(--ink-deep);
    box-shadow:
      var(--shadow-inset),
      var(--shadow-float);
  }

  /*
   * height:auto is load-bearing — <Image> emits height="2622", which wins over
   * any aspect-ratio and squashes the shot in the production build.
   */
  .device-screen {
    width: 100%;
    height: auto;
    border-radius: 38px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-title,
    .hero-copy .lede {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    /*
     * Copy leads on narrow screens. The stage used to be order:-1, which put a
     * ~700px-tall device above the fold and pushed the headline off it. The
     * screenshot is proof, not the pitch — it reads better underneath.
     */
    .device {
      width: min(300px, 70vw);
    }
  }
</style>
