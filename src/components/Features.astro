---
const features = [
  {
    title: 'Needs and Wants, split automatically',
    body: "Every dollar lands in one bucket or the other, so you always know what's left for essentials versus everything else.",
    icon: 'home',
    featured: true,
  },
  {
    title: 'Bills that warn you before they hit',
    body: 'Recurring bills show up days ahead with their due date, so nothing surprises your balance.',
    icon: 'bell',
  },
  {
    title: "Today's real number",
    body: "One figure on Home: what's actually safe to spend today, after bills and savings are accounted for.",
    icon: 'spark',
  },
  {
    title: 'No bank linking required',
    body: 'Log spending yourself in seconds. Nothing to connect, no account credentials to hand over.',
    icon: 'shield',
  },
];

const icons: Record<string, string> = {
  home: '<path d="M4 11.5 12 5l8 6.5" /><path d="M6 10v8.5a1 1 0 0 0 1 1h3.5v-5h3v5H17a1 1 0 0 0 1-1V10" />',
  bell: '<path d="M7 9a5 5 0 0 1 10 0c0 4 1.5 5.5 2 6.5H5c.5-1 2-2.5 2-6.5Z" /><path d="M10 19a2 2 0 0 0 4 0" />',
  spark: '<path d="M12 4v4M12 16v4M4 12h4M16 12h4" /><path d="m6.5 6.5 2.5 2.5M15 15l2.5 2.5M6.5 17.5 9 15M15 9l2.5-2.5" />',
  shield: '<path d="M12 4.5 5.5 7v5c0 4.2 2.8 7 6.5 8.5 3.7-1.5 6.5-4.3 6.5-8.5V7L12 4.5Z" /><path d="m9 12 2 2 4-4" />',
};
---

<section id="features" class="section features">
  <div class="container">
    <header class="features-head" data-reveal>
      <p class="eyebrow">Features</p>
      <h2 class="h2">Built for people who dread budgeting apps.</h2>
      <p class="lede">
        Clear numbers, fewer screens, and language that doesn&rsquo;t make money
        feel like a lecture.
      </p>
    </header>

    <ul class="bento">
      {
        features.map((f, i) => (
          <li
            class:list={['bento-item', f.featured && 'is-featured']}
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="bento-shell">
              <div class="bento-card">
                <svg
                  class="feature-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[f.icon]}
                />
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-body">{f.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features-head {
    max-width: 38rem;
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .features-head .lede {
    max-width: 42ch;
  }

  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
  }

  .bento-item:first-child {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .bento-item:nth-child(2) {
    grid-column: 2 / 4;
    grid-row: 1;
  }

  .bento-item:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  .bento-item:nth-child(4) {
    grid-column: 3;
    grid-row: 2;
  }

  .bento-shell {
    height: 100%;
    padding: 5px;
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--ab-ink) 4%, transparent);
    border: 1px solid var(--ab-border);
    transition:
      transform 400ms var(--ease-spring),
      box-shadow 400ms var(--ease-spring);
  }

  .bento-item:hover .bento-shell {
    transform: translateY(-5px);
    box-shadow: var(--shadow-card);
  }

  .bento-card {
    height: 100%;
    min-height: 180px;
    padding: var(--space-4);
    border-radius: calc(var(--radius-xl) - 4px);
    background: var(--ab-surface-raised);
    border: 1px solid var(--ab-border);
    box-shadow: var(--shadow-inset);
    display: flex;
    flex-direction: column;
  }

  .is-featured .bento-shell {
    background: color-mix(in srgb, var(--ab-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--ab-accent) 22%, transparent);
  }

  .is-featured .bento-card {
    background: linear-gradient(165deg, #6a875c 0%, var(--ab-accent) 48%, #4f6743 100%);
    border-color: transparent;
    justify-content: center;
    min-height: 100%;
    padding: clamp(28px, 4vw, 48px);
  }

  .feature-icon {
    width: 22px;
    height: 22px;
    color: var(--ab-accent);
    background: var(--ab-accent-soft);
    border-radius: 12px;
    padding: 11px;
    box-sizing: content-box;
    margin-bottom: var(--space-2);
    flex-shrink: 0;
  }

  .is-featured .feature-icon {
    width: 28px;
    height: 28px;
    padding: 12px;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
  }

  .feature-title {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ab-ink);
    margin: 0 0 8px;
  }

  .is-featured .feature-title {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    color: var(--ab-accent-on);
    max-width: 14ch;
  }

  .feature-body {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted-copy);
    margin: 0;
    line-height: 1.55;
  }

  .is-featured .feature-body {
    font-size: 1.02rem;
    color: rgba(247, 244, 233, 0.96);
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }

    .bento-item:first-child,
    .bento-item:nth-child(2),
    .bento-item:nth-child(3),
    .bento-item:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
    }

    .bento-item:first-child {
      grid-column: 1 / -1;
    }

    .bento-item:nth-child(2) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .bento-item:first-child,
    .bento-item:nth-child(2) {
      grid-column: auto;
    }
  }
</style>
