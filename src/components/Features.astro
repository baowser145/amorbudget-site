---
const features = [
  {
    title: 'Needs and Wants, split automatically',
    body: "Every dollar lands in one bucket or the other, so you always know what's left for essentials versus everything else.",
    icon: 'home',
  },
  {
    title: 'Bills that warn you before they hit',
    body: 'Recurring bills show up days ahead with their due date, so nothing surprises your balance.',
    icon: 'bell',
  },
  {
    title: "Today's real number",
    body: "One figure on Home: what's actually safe to spend today, after bills and savings are accounted for.",
    icon: 'spark',
  },
  {
    title: 'No bank linking required',
    body: 'Log spending yourself in seconds. Nothing to connect, no account credentials to hand over.',
    icon: 'shield',
  },
];

const icons: Record<string, string> = {
  home: '<path d="M4 11.5 12 5l8 6.5" /><path d="M6 10v8.5a1 1 0 0 0 1 1h3.5v-5h3v5H17a1 1 0 0 0 1-1V10" />',
  bell: '<path d="M7 9a5 5 0 0 1 10 0c0 4 1.5 5.5 2 6.5H5c.5-1 2-2.5 2-6.5Z" /><path d="M10 19a2 2 0 0 0 4 0" />',
  spark: '<path d="M12 4v4M12 16v4M4 12h4M16 12h4" /><path d="m6.5 6.5 2.5 2.5M15 15l2.5 2.5M6.5 17.5 9 15M15 9l2.5-2.5" />',
  shield: '<path d="M12 4.5 5.5 7v5c0 4.2 2.8 7 6.5 8.5 3.7-1.5 6.5-4.3 6.5-8.5V7L12 4.5Z" /><path d="m9 12 2 2 4-4" />',
};
---

<section id="features" class="section features">
  <div class="container">
    <div class="features-head">
      <h2 class="h2">Built for people who dread budgeting apps.</h2>
    </div>
    <ul class="feature-grid">
      {
        features.map((f, i) => (
          <li class="feature-card" data-reveal style={`transition-delay: ${i * 90}ms`}>
            <svg
              class="feature-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[f.icon]}
            />
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features-head {
    max-width: 640px;
    margin-bottom: var(--space-5);
  }

  .feature-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    grid-template-rows: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .feature-card {
    background: var(--ab-surface);
    border: 1.5px solid var(--ab-border);
    border-radius: 20px;
    padding: var(--space-4);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 34px -18px rgba(43, 46, 35, 0.22);
  }

  .feature-card:first-child {
    grid-column: 1;
    grid-row: 1 / 4;
    background: var(--ab-accent);
    border: none;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-card:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
  }

  .feature-card:nth-child(3) {
    grid-column: 2;
    grid-row: 2;
  }

  .feature-card:nth-child(4) {
    grid-column: 2;
    grid-row: 3;
  }

  .feature-icon {
    width: 26px;
    height: 26px;
    color: var(--ab-accent);
    background: var(--ab-accent-soft);
    border-radius: 12px;
    padding: 9px;
    box-sizing: content-box;
    margin-bottom: var(--space-2);
    flex-shrink: 0;
  }

  .feature-card:first-child .feature-icon {
    width: 32px;
    height: 32px;
    padding: 12px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.16);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 800;
    color: var(--ab-ink);
    margin: 0 0 6px;
  }

  .feature-card:first-child .feature-title {
    font-size: 23px;
    color: var(--ab-accent-on);
    max-width: 14ch;
  }

  .feature-body {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--muted-copy);
    margin: 0;
    line-height: 1.55;
  }

  .feature-card:first-child .feature-body {
    font-size: 15.5px;
    color: #ffffff;
    max-width: 32ch;
  }

  @media (max-width: 780px) {
    .feature-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .feature-card:first-child,
    .feature-card:nth-child(2),
    .feature-card:nth-child(3),
    .feature-card:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
