---
/*
 * Four cards, each tinted with one of the brand's own soft tokens. The bento
 * grid this replaced put one feature on a big olive slab and the other three
 * on white — which read as a hierarchy the product doesn't actually have.
 * All four matter equally, so all four get the same weight and their own hue.
 */
const features = [
  {
    title: 'Needs vs Wants',
    body: 'Every dollar lands in one of two buckets: what you must pay, and what you choose to spend.',
    icon: 'home',
    tone: 'sage',
  },
  {
    title: 'Bills warn you early',
    body: 'See due dates days before they hit.',
    icon: 'bell',
    tone: 'blush',
  },
  {
    title: 'One number for today',
    body: 'Open the app, read the number, done.',
    icon: 'spark',
    tone: 'gold',
  },
  {
    title: 'Log spends in seconds',
    body: 'Manual entry, so you notice every dollar.',
    icon: 'pencil',
    tone: 'cream',
  },
];

const icons: Record<string, string> = {
  home: '<path d="M4 11.5 12 5l8 6.5" /><path d="M6 10v8.5a1 1 0 0 0 1 1h3.5v-5h3v5H17a1 1 0 0 0 1-1V10" />',
  bell: '<path d="M7 9a5 5 0 0 1 10 0c0 4 1.5 5.5 2 6.5H5c.5-1 2-2.5 2-6.5Z" /><path d="M10 19a2 2 0 0 0 4 0" />',
  spark: '<path d="M12 4v4M12 16v4M4 12h4M16 12h4" /><path d="m6.5 6.5 2.5 2.5M15 15l2.5 2.5M6.5 17.5 9 15M15 9l2.5-2.5" />',
  pencil: '<path d="M4 19.5 8 18.5 19 7.5a2.1 2.1 0 0 0-3-3L5 15.5Z" /><path d="m14.5 6 3 3" />',
};
---

<section id="features" class="section features">
  <div class="container">
    <header class="features-head" data-reveal>
      <h2 class="h2">
        Built around how<br />
        <em class="ital ital-blush">real people</em> budget.
      </h2>
      <div class="features-head-aside">
        <p class="eyebrow-bare">Features</p>
        <p class="lede">
          Just the essentials, so you stick with it.
        </p>
      </div>
    </header>

    <ul class="cards">
      {
        features.map((f, i) => (
          <li
            class={`card card-${f.tone}`}
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
          >
            <svg
              class="card-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[f.icon]}
            />
            <h3 class="card-title">{f.title}</h3>
            <p class="card-body">{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: end;
    gap: var(--space-3) clamp(24px, 5vw, 64px);
    margin-bottom: var(--space-5);
  }

  .features-head-aside .lede {
    max-width: 38ch;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.4vw, 30px);
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
    transition:
      transform 420ms var(--ease-spring),
      box-shadow 420ms var(--ease-spring);
  }

  /*
   * data-reveal owns transform while the card is animating in, so the hover
   * lift is only attached once the card has landed. Without :not(), hovering
   * mid-reveal cancels the entrance and the card snaps into place.
   */
  .card.is-visible:hover,
  html:not(.js) .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card);
  }

  .card-sage {
    background: var(--ab-accent-soft);
    border-color: color-mix(in srgb, var(--ab-accent) 18%, transparent);
  }

  .card-blush {
    background: var(--ab-wants-soft);
    border-color: color-mix(in srgb, var(--ab-wants) 32%, transparent);
  }

  .card-gold {
    background: var(--ab-gold-soft);
    border-color: color-mix(in srgb, var(--ab-gold) 30%, transparent);
  }

  .card-cream {
    background: var(--ab-bg-deep);
    border-color: var(--ab-border-strong);
  }

  .card-icon {
    width: 22px;
    height: 22px;
    padding: 11px;
    box-sizing: content-box;
    border-radius: 14px;
    background: var(--ab-surface-raised);
    margin-bottom: var(--space-3);
    flex-shrink: 0;
    box-shadow: var(--shadow-soft);
  }

  .card-sage .card-icon {
    color: var(--ab-accent-text);
  }

  .card-blush .card-icon {
    color: var(--ab-wants-text);
  }

  .card-gold .card-icon {
    color: var(--ab-gold-text);
  }

  .card-cream .card-icon {
    color: var(--ab-ink);
  }

  /*
   * Card titles are display type too — small, but Fraunces. It's what ties
   * these back to the headline above them rather than reading as a separate
   * UI kit.
   */
  .card-title {
    font-family: var(--ab-display);
    font-weight: 700;
    font-size: 1.18rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .card-sage .card-title {
    color: var(--ab-accent-text);
  }

  .card-blush .card-title {
    color: var(--ab-wants-text);
  }

  .card-gold .card-title {
    color: var(--ab-gold-text);
  }

  .card-cream .card-title {
    color: var(--ab-ink);
  }

  .card-body {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--muted-copy);
  }

  @media (max-width: 1020px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .features-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .features-head-aside {
      display: flex;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
