---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { products, isLive, productUrl, type Product } from '../../data/products';
import { site } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const live = isLive(product);
const buyHref = productUrl(product);

// Kept flat: a nested multi-line template literal in frontmatter makes the
// Astro compiler lose the fence and emit it as page text.
const mailSubject = encodeURIComponent(product.name + ' interest');
const mailto = 'mailto:' + site.contactEmail + '?subject=' + mailSubject;
const others = products.filter((p) => p.slug !== product.slug);
---

<Layout title={product.name + ' — Amor Budget'} description={product.blurb}>
  <Nav />
  <main class="merch-page">
    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Amor Budget</a>
        <span aria-hidden="true">/</span>
        <a href="/merch">Merch</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.name}</span>
      </nav>

      <article class="product">
        <div class="product-media" data-reveal>
          <div class="stage">
            {
              product.images.map((img, i) => (
                <Image
                  class={i === 0 ? 'shot is-active' : 'shot'}
                  data-shot={i}
                  src={img.src}
                  alt={img.alt}
                  widths={[600, 900, 1200]}
                  sizes="(max-width: 900px) 92vw, 560px"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
            {
              product.images.length === 0 && (
                <div class="shot shot-empty">
                  <span>Product photo coming</span>
                </div>
              )
            }
          </div>
          {
            product.images.length > 1 && (
              <ul class="thumbs">
                {product.images.map((img, i) => (
                  <li>
                    <button
                      type="button"
                      class={i === 0 ? 'thumb is-active' : 'thumb'}
                      data-thumb={i}
                      aria-label={`View image ${i + 1} of ${product.images.length}`}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                    >
                      <Image src={img.src} alt="" widths={[120, 240]} sizes="72px" loading="lazy" />
                    </button>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="product-info" data-reveal>
          <p class="eyebrow">{product.eyebrow}</p>
          <h1 class="h1 product-name">{product.name}</h1>
          <p class="price">
            From {product.priceFrom}
            <span class="price-note">larger sizes priced up</span>
          </p>
          <p class="lede">{product.blurb}</p>

          <div class="sizes">
            <h2 class="label">Sizes</h2>
            <ul class="size-list">
              {product.sizes.map((s) => <li>{s}</li>)}
            </ul>
          </div>

          {
            live ? (
              <a
                class="btn btn-primary buy"
                href={buyHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                Buy this shirt
                <span class="btn-icon" aria-hidden="true">↗</span>
              </a>
            ) : (
              <a class="btn btn-primary buy" href={mailto}>
                Tell me when it&rsquo;s live
                <span class="btn-icon" aria-hidden="true">→</span>
              </a>
            )
          }

          <p class="fulfilment">
            {
              live
                ? 'Checkout and shipping are handled by Shopify. Printed on demand, so nothing sits in a warehouse.'
                : 'This one isn’t on sale yet. Leave a note and you’ll hear first.'
            }
          </p>

          <div class="details">
            <h2 class="label">Details</h2>
            <ul class="spec-list">
              {product.specs.map((s) => <li>{s}</li>)}
            </ul>
            {product.note && <p class="note">{product.note}</p>}
          </div>
        </div>
      </article>

      {
        others.length > 0 && (
          <section class="more" data-reveal>
            <h2 class="label">More from Amor Budget</h2>
            <ul class="more-list">
              {others.map((p) => (
                <li>
                  <a href={`/merch/${p.slug}`}>
                    <span class="more-name">{p.name}</span>
                    <span class="more-price">From {p.priceFrom}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /*
   * Deliberately quieter than the marketing page. No shells, no gradients —
   * a product page earns attention by getting out of the product's way.
   */
  .merch-page {
    padding: var(--space-5) 0 var(--space-7);
  }

  .crumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--space-4);
    font-size: 13px;
    font-weight: 700;
    color: var(--ab-faint);
  }

  .crumb a {
    color: var(--ab-faint);
    text-decoration: none;
    transition: color 220ms var(--ease-spring);
  }

  .crumb a:hover {
    color: var(--ab-accent-text);
  }

  .product {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  /* ---------- media ---------- */

  .product-media {
    position: sticky;
    top: 104px;
  }

  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--ab-surface);
    border: 1px solid var(--ab-border);
  }

  .shot-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ab-bg-deep);
    border-style: dashed;
    border-color: var(--ab-border-strong);
    color: var(--ab-faint);
    font-size: 14px;
    font-weight: 700;
  }

  /*
   * The views are stacked in one grid cell and cross-faded, so swapping
   * never reflows the page or reloads an image the browser already has.
   */
  .stage {
    display: grid;
  }

  .stage .shot {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
  }

  .stage .shot.is-active {
    opacity: 1;
  }

  /* The empty state carries .shot too, so opt it back into being visible. */
  .stage .shot-empty {
    opacity: 1;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
    line-height: 0;
    transition: border-color 200ms var(--ease-out);
  }

  .thumb:hover {
    border-color: var(--ab-border-strong);
  }

  .thumb.is-active {
    border-color: var(--ab-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .stage .shot,
    .thumb {
      transition: none;
    }
  }

  /*
   * Fixed tracks, not 1fr: every image is a thumbnail now, and stretching
   * two of them across the column makes them read as a second hero row.
   */
  .thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, 84px);
    gap: 10px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .thumbs img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--ab-border);
    background: var(--ab-surface);
  }

  /* ---------- info ---------- */

  .product-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-1);
  }

  .product-name {
    /* Smaller than a marketing h1 — this is a label, not a headline. */
    font-size: clamp(2.1rem, 4vw, 3.1rem);
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ab-ink);
  }

  .price-note {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--ab-faint);
  }

  .label {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ab-faint);
  }

  .sizes {
    margin-top: var(--space-1);
  }

  .size-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .size-list li {
    min-width: 46px;
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--ab-surface-raised);
    border: 1px solid var(--ab-border-strong);
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    color: var(--ab-ink);
  }

  .buy {
    margin-top: var(--space-2);
    align-self: stretch;
  }

  .fulfilment {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ab-faint);
  }

  .details {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ab-border);
    width: 100%;
  }

  .spec-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .spec-list li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    color: var(--muted-copy);
  }

  .spec-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--ab-accent);
  }

  .note {
    margin: var(--space-2) 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ab-faint);
  }

  /* ---------- more ---------- */

  .more {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ab-border);
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background: var(--ab-surface-raised);
    border: 1px solid var(--ab-border);
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    transition: border-color 220ms var(--ease-spring), transform 220ms var(--ease-spring);
  }

  .more-list a:hover {
    border-color: color-mix(in srgb, var(--ab-accent) 40%, transparent);
    transform: translateY(-2px);
  }

  .more-price {
    color: var(--ab-faint);
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .product {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .product-media {
      position: static;
    }
  }
</style>

<script>
  /*
   * Thumbnails are real buttons, so keyboard activation comes free from the
   * browser. This only has to move the is-active flag.
   */
  document.querySelectorAll<HTMLElement>('.product-media').forEach((media) => {
    const shots = media.querySelectorAll<HTMLElement>('[data-shot]');
    const thumbs = media.querySelectorAll<HTMLButtonElement>('[data-thumb]');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.thumb;
        shots.forEach((shot) => {
          shot.classList.toggle('is-active', shot.dataset.shot === index);
        });
        thumbs.forEach((other) => {
          const on = other.dataset.thumb === index;
          other.classList.toggle('is-active', on);
          other.setAttribute('aria-pressed', String(on));
        });
      });
    });
  });
</script>
