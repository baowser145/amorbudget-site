---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Merch from '../components/Merch.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Privacy from '../components/Privacy.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';

/*
 * Merch sits second, directly under the hero, at the user's request — kept
 * there after the app's 2026-08 App Store release, since the hero and
 * closing CTAs now carry the download conversion and merch would otherwise
 * have no above-the-fold presence at all.
 *
 * Band rhythm, top to bottom: cream, sand, dark, cream, olive, dark. No two
 * neighbours share a ground.
 */
---

<Layout
  title="Amor Budget — Budgeting you'll actually love"
  description="One number that says what's safe to spend today. Needs vs Wants, bill reminders, no bank linking. Now on the App Store."
>
  <Nav />
  <main>
    <Hero />
    <Merch />
    <HowItWorks />
    <Features />
    <Privacy />
    <Closing />
  </main>
  <Footer />
</Layout>
