---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Resources from '../components/Resources.astro';
import Merch from '../components/Merch.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Amor Budget — Budgeting you'll actually love"
  description="A budgeting app that splits every dollar into Needs and Wants, warns you before bills hit, and shows what's safe to spend today. No bank linking required."
>
  <Nav />
  <main>
    <Hero />
    <Features />
    <Screenshots />
    <Resources />
    <Merch />
  </main>
  <Footer />
</Layout>
